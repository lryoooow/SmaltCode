{
  "name": "@smalt/kernel",
  "version": "0.0.6",
  "description": "The smalt agent kernel: threads, turns, items, tools, permissions, and a JSON-RPC app-server protocol.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "node ../../scripts/sync-version.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
