{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": "../..",
    "paths": {
      "react": [
        "node_modules/@types/react"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ],
      "react-dom/*": [
        "node_modules/@types/react-dom/*"
      ],
      "react-markdown": [
        "node_modules/react-markdown"
      ],
      "remark-gfm": [
        "node_modules/remark-gfm"
      ]
    }
  },
  "include": [
    "src/renderer/src"
  ]
}
